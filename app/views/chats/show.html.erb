<div class="container mx-auto p-4">
  <h1 class="text-2xl font-bold mb-4">Chat with <%= @other_user.name %></h1>

  <%# The Channel listener %>
    <%# app/views/chats/show.html.erb %>
    <%= turbo_stream_from @chat %>

    <div id="messages_container">
        <div id="messages"> <%# The target for the broadcast %>
            <%= render @messages %>
        </div>
    </div>

  <div class="message-form">
    <%= form_with(model: [@chat, @new_message], data: { turbo_action: "replace" }) do |f| %>
      <div class="flex gap-2">
        <%= f.text_field :content, placeholder: "Type a message...", class: "flex-1 border rounded p-2", autocomplete: 'off' %>
        <%= f.submit "Send", class: "bg-blue-600 text-white px-4 py-2 rounded" %>
      </div>
    <% end %>
  </div>
</div>