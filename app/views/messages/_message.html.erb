<div id="<%= dom_id message %>" 
     class="flex mb-4 message-row" 
     data-author-id="<%= message.user_id %>">
     
  <div class="message-bubble max-w-xs px-4 py-2 rounded-lg bg-gray-200 text-gray-800">
    <div class="text-xs font-bold mb-1 text-success"><%= message.user.name %></div>
    <div class="text-sm text-primary"><%= message.content %></div>
    <div class="text-[10px] opacity-75 mt-1 text-right">
      <%= message.created_at.strftime("%I:%M %p") %>
    </div>
  </div>
</div>